[track lb7]
A-2*4 A#2*2 A-2*2 G-2*4 F-2*4
[track lb8]
E-2*4 F-2*2 E-2*2 D-2*6 ^*2

# Bridge – telemetryczne dzwonki
[track lr1]
D-3@bell*4 F-3*4 A-3*8
[track lr2]
C-3*4 E-3*4 G-3*8
[track lr3]
A#2*4 D-3*4 F-3*8
[track lr4]
A-2*4 C#3*4 E-3*8

# Odzewy brass
[track br1]
.*8 D-3v48@brass*4 A-3*4
[track br2]
.*8 C-3v48@brass*4 G-3*4
[track br3]
.*8 A#2v48@brass*4 F-3*4
[track br4]
.*8 A-2v48@brass*4 E-3*4

# Multiball – szybki galop basu 16-tkami
[track mbt]
C-3@kick*2 C-3@hat C-3 C-3@snare*2 C-3@hat C-3 C-3@kick*2 C-3@hat C-3 C-3@snare*2 C-3@ohat*2
[track mbtc]
C-3@crash*2 C-3@hat C-3 C-3@snare*2 C-3@hat C-3 C-3@kick*2 C-3@hat C-3 C-3@snare*2 C-3@ohat*2
[track mfill]
